# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/telehealings

# JWT
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRATION=24h

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=telehealings-files

# Email (optional for development)
EMAIL_FROM=noreply@telehealings.com
SENDGRID_API_KEY=

# Redis (for sessions/real-time)
REDIS_URL=redis://localhost:6379

# Twilio (for SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeMe123!

# Frontend
FRONTEND_URL=http://localhost:8081
