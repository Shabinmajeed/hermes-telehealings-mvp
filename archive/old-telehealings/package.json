{
  "name": "telehealings",
  "version": "0.1.0",
  "description": "Telehealings - Complete Telehealth Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run start:backend & npm run start:frontend",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm start -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "format": "npm run format -w backend && npm run format -w frontend",
    "test": "npm run test -w backend",
    "test:watch": "npm run test:watch -w backend",
    "type-check": "npm run type-check -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
