{
  "$schema": "TeleHealings Design Tokens v1.0",
  "description": "Unified design tokens for all platforms (mobile, therapist web, admin web). Derived from audit of 60 HTML mockups. Single source of truth.",

  "colors": {
    "primary": {
      "50": "#eff6ff",
      "100": "#dbeafe",
      "200": "#bfdbfe",
      "300": "#93c5fd",
      "400": "#60a5fa",
      "500": "#3b82f6",
      "600": "#2563eb",
      "700": "#1d4ed8",
      "800": "#1e40af",
      "900": "#1e3a8a"
    },
    "brand": {
      "blue": "#387bd5",
      "blueDark": "#0745b1",
      "blueLight": "#5b96ea"
    },
    "neutral": {
      "0": "#ffffff",
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#475569",
      "700": "#334155",
      "800": "#1e293b",
      "900": "#0f172a",
      "1000": "#000000"
    },
    "text": {
      "primary": "#0f172a",
      "secondary": "#334155",
      "tertiary": "#64748b",
      "placeholder": "#94a3b8",
      "inverse": "#ffffff",
      "link": "#2563eb"
    },
    "border": {
      "default": "#e2e8f0",
      "light": "#f1f5f9",
      "focus": "#2563eb"
    },
    "surface": {
      "background": "#ffffff",
      "backgroundAlt": "#f8fafc",
      "card": "#ffffff",
      "overlay": "rgba(0, 0, 0, 0.5)"
    },
    "status": {
      "success": "#10b981",
      "successLight": "#dcfce7",
      "successDark": "#166534",
      "warning": "#f59e0b",
      "warningLight": "#fef3c7",
      "warningDark": "#b45309",
      "error": "#ef4444",
      "errorLight": "#fee2e2",
      "errorDark": "#b91c1c",
      "info": "#3b82f6",
      "infoLight": "#dbeafe"
    }
  },

  "typography": {
    "fontFamily": {
      "primary": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "md": "15px",
      "lg": "16px",
      "xl": "18px",
      "2xl": "20px",
      "3xl": "24px",
      "4xl": "28px",
      "5xl": "32px",
      "6xl": "36px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.4,
      "relaxed": 1.6,
      "loose": 1.8
    },
    "letterSpacing": {
      "tighter": "-0.5px",
      "tight": "-0.3px",
      "normal": "0px",
      "wide": "0.05em",
      "wider": "0.1em"
    }
  },

  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px",
    "9": "48px",
    "10": "64px"
  },

  "borderRadius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "3xl": "24px",
    "full": "9999px",
    "pill": "99px"
  },

  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px rgba(0, 0, 0, 0.05)",
    "lg": "0 10px 15px rgba(0, 0, 0, 0.08)",
    "xl": "0 20px 25px rgba(0, 0, 0, 0.1)",
    "card": "0 4px 15px rgba(0, 0, 0, 0.02)",
    "modal": "0 20px 40px rgba(0, 0, 0, 0.1)",
    "dropdown": "0 10px 30px rgba(0, 0, 0, 0.1)"
  },

  "layout": {
    "admin": {
      "sidebarWidth": "260px",
      "contentMaxWidth": "1100px",
      "headerHeight": "64px"
    },
    "therapist": {
      "sidebarWidth": "240px",
      "contentMaxWidth": "1100px",
      "headerHeight": "64px"
    },
    "mobile": {
      "maxWidth": "380px",
      "bottomNavHeight": "64px",
      "safeAreaTop": "env(safe-area-inset-top)",
      "safeAreaBottom": "env(safe-area-inset-bottom)"
    }
  },

  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms",
      "verySlow": "600ms"
    },
    "easing": {
      "ease": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "easeIn": "cubic-bezier(0.42, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.58, 1)",
      "easeInOut": "cubic-bezier(0.42, 0, 0.58, 1)",
      "spring": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },

  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 500,
    "fixed": 1000,
    "modal": 2000,
    "popover": 2500,
    "tooltip": 3000
  }
}
