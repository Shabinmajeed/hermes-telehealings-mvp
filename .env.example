# TeleHealings Docker Environment
# Copy to .env and update values

POSTGRES_PASSWORD=telehealings_secret
JWT_SECRET=change_me_use_random_64_char_string

# SMTP (optional in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TeleHealings <noreply@telehealings.com>

# Stripe (optional in dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (optional in dev)
REDIS_HOST=localhost
REDIS_PORT=6379
