# TeleHealings Docker Environment
# Copy to .env and adjust values for production

# PostgreSQL
POSTGRES_PASSWORD=telehealings_dev_password

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-32chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe (replace with real keys in production)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# SMTP (configure for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TeleHealings <noreply@telehealings.com>
